# Database — must match the postgres service in docker-compose
DATABASE_URL=postgresql+psycopg2://keep:keep@db:5432/keep

# Odyssey (egress replies go through here)
ODYSSEY_URL=http://host.docker.internal:3000
ODYSSEY_API_KEY=replace_with_gateway_api_key

# Webhook auth — sent as x-gateway-secret by Odyssey
NOTES_WEBHOOK_SECRET=replace_with_notes_webhook_secret

# Direct ingestion auth (NOT Odyssey)
EXTENSION_TOKEN=replace_with_extension_token
ESP32_TOKEN=replace_with_esp32_token

# For voice transcription (LangChain + Gemini) — not yet wired
# GEMINI_API_KEY=replace_with_gemini_key

PORT=3005
